{
    "version": 3,
    "configurePresets": [
        {
            "name": "local-good-debug",
            "description": "Debug build with good fast settings",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "MANUAL_SUBMODULES": "",
                "GRIDTERM_CWD": "~/code/core/pay2exchange-core",
                "GRIDTERM_BLOCKCHAIN": "ec2",
                "GRIDTERM_MYNODE": "1",
                "GRIDTERM_NODES_WIT": "2",
                "GRIDTERM_NODES_USER": "1"
            }
        },
        {
            "name": "local-good-debug-testing",
            "description": "Debug build with testing configuration (more nodes)",
            "inherits": "local-good-debug",
            "cacheVariables": {
                "GRIDTERM_CWD": "~/code/core/pay2exchange-core",
                "GRIDTERM_BLOCKCHAIN": "ec2",
                "GRIDTERM_MYNODE": "1",
                "GRIDTERM_NODES_WIT": "4",
                "GRIDTERM_NODES_USER": "3"
            }
        },
        {
            "name": "local-good-debug-minimal",
            "description": "Debug build with minimal configuration (fewer nodes)",
            "inherits": "local-good-debug",
            "cacheVariables": {
                "GRIDTERM_CWD": "~/code/core/pay2exchange-core",
                "GRIDTERM_BLOCKCHAIN": "ec2",
                "GRIDTERM_MYNODE": "1",
                "GRIDTERM_NODES_WIT": "1",
                "GRIDTERM_NODES_USER": "1"
            }
        },
        {
            "name": "clang-18-debug",
            "displayName": "Clang 18.1.3 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang-18, CXX = /usr/bin/clang++-18",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang-18",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18",
                "CMAKE_BUILD_TYPE": "Debug",
                "GRIDTERM_CWD": "~/code/core/pay2exchange-core",
                "GRIDTERM_BLOCKCHAIN": "ec2",
                "GRIDTERM_MYNODE": "1",
                "GRIDTERM_NODES_WIT": "2",
                "GRIDTERM_NODES_USER": "1"
            }
        },
        {
            "name": "clang-20-debug",
            "displayName": "Clang 20 x86_64-pc-linux-gnu",
            "description": "Using compilers: C = /usr/bin/clang-20, CXX = /usr/bin/clang++-20",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/clang-20",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
                "CMAKE_BUILD_TYPE": "Debug",
                "GRIDTERM_CWD": "~/code/core/pay2exchange-core",
                "GRIDTERM_BLOCKCHAIN": "ec2",
                "GRIDTERM_MYNODE": "1",
                "GRIDTERM_NODES_WIT": "2",
                "GRIDTERM_NODES_USER": "1"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "local-good-debug-build",
            "configurePreset": "local-good-debug",
            "targets": ["run"]
        },
        {
            "name": "local-good-debug-testing-build",
            "configurePreset": "local-good-debug-testing",
            "targets": ["run"]
        },
        {
            "name": "local-good-debug-minimal-build",
            "configurePreset": "local-good-debug-minimal",
            "targets": ["run"]
        },
        {
            "name": "clang-18-debug-build",
            "configurePreset": "clang-18-debug",
            "targets": ["run"]
        },
        {
            "name": "clang-20-debug-build",
            "configurePreset": "clang-20-debug",
            "targets": ["run"]
        }
    ],
    "testPresets": [
        {
            "name": "local-good-debug-test",
            "configurePreset": "local-good-debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}