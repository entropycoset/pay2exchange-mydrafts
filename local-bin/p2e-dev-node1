function main_start_node(given_arg)
	given_arg = given_arg or {}

	local cfg_mode = given_arg[1] or "normal"
	local cfg_chain = given_arg[2] or "default"
	local cfg_role = given_arg[3] or "node"

	print("Mode of this script: " .. cfg_mode .. " ; Blockchain/genesis: " .. cfg_chain .. " ; our role: " .. cfg_role)

	-- Special edit mode
	if cfg_mode == "x" then
			local script = debug.getinfo(1).source:sub(2) -- get current script path
			os.execute("vim " .. script)
			print("After editing myself - exit")
			os.exit()
	end
	if cfg_mode == "x2" then
			local script = debug.getinfo(1).source:sub(2) -- get current script path
			mylib_simpleexec.simple_exec("vim", {script})
			print("After editing myself (x2) - exit")
			os.exit()
	end
	if cfg_mode == "h" then
		help()
		os.exit()
	end

	print([[
	=====================================================================
	]])

	-- Compile showargs if not present
	local function file_exists(path)
			local f = io.open(path, "r")
			if f then f:close() return true else return false end
	end

	if not file_is_executable("./showargs") then
			if file_exists("./showargs.cpp") then
					local res = os.execute("g++ showargs.cpp -o showargs")
					if res ~= 0 then print("Cannot compile showargs") end
			end
	end

	-- good_rand() - safely generate random int in range
	local function good_rand(max)
			local max_limit = 4294967296 - 2
			if max >= max_limit then
					io.stderr:write("ERROR: max value (" .. max .. ") exceeds 32bit limit (" .. max_limit .. ")\n")
					os.exit(1)
			end
			local handle = io.popen("od -An -N4 -tu4 < /dev/urandom")
			local rnd = tonumber(handle:read("*a"):match("%d+"))
			handle:close()
			return rnd % (max + 1)
	end

	-- old
	print("Cleanup of old run data (delete / remove) - the old format (not sandbox)")
	os.execute("rm -rf ./witness_node_data_dir/") -- No check, will continue on error
	if cfg_mode == "d" then
		print("Removed - done, exiting")
		os.exit()
	end

	local userindex = get_userindex(arg)
		local runsubdir = get_runsubdir(arg)
		program_relative = "" -- extra relative path to reach the program, e.g. extra ../ or ../../ to climb more up if we go deep here

		local sandbox_path
		if runsubdir then
				sandbox_path = "run/" .. runsubdir .. "/var-" .. cfg_role .. "_" .. userindex
				program_relative = "../"
		else
				sandbox_path = "run/var-" .. cfg_role .. "_" .. userindex
		end

	local sandboxdir = mylib_sandboxdir:new(sandbox_path)
	sandboxdir:start()
	print("now I am in directory: " .. lfs.currentdir())

	local portindex = get_portindex(arg)
	local p1 = get_arg_int(arg,"portrpc",1,65535, false, nil);
	local p2 = get_arg_int(arg,"portp2p",1,65535, false, nil);
	if (portindex) and (p1 or p2) then error("Do not provide at same time arguments portindex as well as portrpc/portp2p") ; end
	if (not portindex) and (not(p1 or p2)) then print("Warning: ports are not specified") ; end	 -- allowed for non-node use such as calculating chainid
	-- error("Provide either arguments portindex or (portrpc/portp2p)") ; end

	local port1,port2

	if portindex ~= nil then
		if portindex == -1 then
			print("Generate random ports")
			local r1 = good_rand(970)
			port1 = r1 + 1025
			port2 = port1 + 1
		else
			port1 = portindex*2 + 1025;
			port2 = port1 + 1;
		end
	else
		port1=p1
		port2=p2
	end
	if (port1 and port2) then print("port1=" .. port1 .. " port2=" .. port2) else print("Ports not given"); end
	local netip = get_netip(arg)

	local home = os.getenv("HOME")

	-- Determine genesis file
	local genesis_map = {
			default = { genesis = home .. "/chain-p2e/test-genesis-p2e1.json", private = nil },
			p2e1 = { genesis = home .. "/chain-p2e/test-genesis-p2e1.json", private = nil }, -- the private json is somewhere (todo?)
			ec1	 = { genesis = home .. "/chain-p2e/test-genesis-ec1.json", private = home .. "/chain-p2e/SECRET/test-genesis-ec1/private.json" },
			ec2	 = { genesis = home .. "/chain-p2e/test-genesis-ec2.json", private = home .. "/chain-p2e/SECRET/test-genesis-ec2/private.json" },
			ec3	 = { genesis = home .. "/chain-p2e/test-genesis-ec3.json", private = home .. "/chain-p2e/SECRET/test-genesis-ec3/private.json" },
			bit2	= { genesis = home .. "/chain-p2e/bitshares1-mod.json", private = nil }, -- real bitshares main chain
			bit	 = { genesis = home .. "/chain-p2e/bitshares1.json", private = nil }, -- real bitshares main chain
	}
	local genesis_fn_public_normal = genesis_map[cfg_chain].genesis
	local genesis_fn_private = genesis_map[cfg_chain].private

	if not genesis_map[cfg_chain] then
			print("Unknown chain: " .. cfg_chain)
	end

	print("Genesis filename: " .. genesis_fn_public_normal .. " (original)")

	-- Update initts - initial timestamp
	local initts = get_initts(arg)
	print("initts=" .. initts)
	if initts == "org" then
			genesis_fn_public_final = genesis_fn_public_normal
		print("Using original timestamp without any change, will use genesis: " .. genesis_fn_public_final)
		else
				-- call script ./makechain-1.lua to update timestamp
				print("Using custom timestamp: " .. initts)
				local out = "genesis_timenow.json"
				os.execute("makechain-1.lua -t " .. initts .. " " .. genesis_fn_public_normal )
				local mod1 = extractFilenameFromPath(genesis_fn_public_normal:gsub("%.json$", ".mod.json"))
				-- local mod2 = sandboxdir.dirname .. PATH_SEPARATOR .. mod1 -- not neded sine we changed dir there
				local genesis_fn_public_mod = mod1
				print("The mod genesis will be in: " .. genesis_fn_public_mod)
				copy_file(out, genesis_fn_public_mod)
				genesis_fn_public_final = genesis_fn_public_mod
		end


	-- Load secret
	local mykey = { pub = nil, priv = nil }
	local mysettings = { witness_id = nil }

	if cfg_role == "one" then -- the old way
		mykey.pub = "BTS5k46b9hXwYjLCZZy8usUGjtREeoQeEoLRUonJVkvp9GvVM3bx9"
		local privkey1_fullfn = home .. "/.devel/SECRET/pay2exchange/" .. mykey.pub .. ".secret"
		local privkey1_secret = ""
		if not file_exists(privkey1_fullfn) then
				print("Cannot read secret file (" .. privkey1_fullfn .. "). Aborting.")
				os.exit(1)
		else
				local file = io.open(privkey1_fullfn, "r")
				local line = file:read("*l")
				file:close()
				if not line:match("^[%w]+$") then
						print("The data read does not look correct. Aborting.")
						os.exit(1)
				else
						privkey1_secret = line
						print("Read secret key.")
						mykey.priv = privkey1_secret
						mysettings.witness_id = '1.6.1'
				end
		end
	elseif begins_with(cfg_role, "wit") then
		wit=cfg_role
		print("You are a witness (" .. wit .. ")")
		if not genesis_fn_private then
			error("You attempt to have role of a witness, but we do not have genesis-private. wrong chain? chain is: " .. cfg_chain)
		end
		local wit_num_str = wit:match("^wit(%d+)$")
		local wit_num = tonumber(wit_num_str)
		print("You are a witness number: " .. wit_num)
		mysettings.witness_id = '1.6.' .. tostring(wit_num)
		mykey = extract_keys_jsonfile(genesis_fn_private, cfg_role)
	elseif cfg_role == "chainid" then
		print("You are just a run of the node to use following utility: get chainid")
	elseif begins_with(cfg_role, "node") then
		print("You are just a node (not a witness - not loading wit privkey)")
	else
		print("Unknown role (" .. cfg_role .. ")")
		os.exit(1)
	end

	-- Construct program arguments
	core_base = os.getenv("P2E_CORE_HOME") -- e.g. /home/user/work/pay2exchange-core/
	print(core_base)
	if core_base == nil then
		error("You must set env variable P2E_CORE_HOME")
	end

	-- local prog = program_relative .. "../../../../../programs/witness_node/witness_node"
	local prog = core_base .. "programs/witness_node/witness_node"
	local execargs = {
			"--genesis-json=" .. genesis_fn_public_final
			,"--enable-stale-production",
	}

	if (netip and port1) then table.insert(execargs, "--rpc-endpoint=" .. netip .. ":" .. port1) ; end
	if (netip and port2) then table.insert(execargs, "--p2p-endpoint=" .. netip .. ":" .. port2) ; end


		-- "--enable-stale-production",
	if mykey.pub or mykey.priv then
		if not (mykey.pub and mykey.priv) then
			error("If you set mykey then set all of it.")
		end
		local arg_add = string.format('--private-key=["%s", "%s"]', mykey.pub, mykey.priv)
		print("Creating arg to set private-key: " .. arg_add)
		table.insert(execargs, arg_add)
	end

	if mysettings.witness_id then
		table.insert(execargs, '--witness-id="' .. mysettings.witness_id ..	 '"')
	end

	-- pass extra execargs -e
	local function args_after_e(args)
		local found = false
		local result = {}
		local found_ix = 0
		for ix, v in pairs(args) do
			if found then
				if ix > found_ix then
					table.insert(result, v)
				end
			elseif v == "-e" then
				found = true
				found_ix = ix
			end
		end
		return result
	end

	local after_e = args_after_e(arg)
	if #after_e > 0 then
		for i = 1, #after_e do
				execargs[#execargs + 1] = after_e[i]
		end
	end

	if cfg_role == "chainid" then
		-- prog = core_base .. "programs/cli_wallet/cli_wallet"
		--execargs = {
		--"--genesis-json=" .. genesis_fn_public_final
		--}

		table.insert(execargs, "--exit") -- exit after chainid
		-- table.insert(execargs, "--minimal")
		table.insert2(execargs, "--write-chainid", global_filename_for_chainid)
	end

	print("Current CWD=[" .. lfs.currentdir() .. "], and will now check the program")
	if not file_is_executable(prog) then
			io.stderr:write("ERROR: Required program '" .. prog .. "' not found or not executable (from cwd=".. lfs.currentdir() ..".\n")
			os.exit(1)
	end

	show_args_bin(execargs)
	show_args_simple(execargs)

	print("---------------------------------------------------------------------")

	local run_modes={}

	for _, v in ipairs(arg) do
		if v == "-dry" then print("Dry run requested. See args above. Exiting.\n") os.exit(0) end
	end

	run_modes.n = function()
			mylib_simpleexec.simple_exec(prog, execargs, true);
	end
	run_modes.normal = run_modes.n
	run_modes.gdb = function()
			mylib_simpleexec.simple_exec("gdb", {"--args", prog, unpack(execargs)}, true);
	end
	run_modes.net1 = function()
			mylib_simpleexec.simple_exec(prog, execargs, true);
	end

	print("---------------------------------------------------------------------")
	if run_modes[cfg_mode] then
			print("Executing the configured mode " .. cfg_mode .. ", role " .. cfg_role )
			run_modes[cfg_mode]()
	else
			print("Unknown mode: " .. cfg_mode)
	end

	print([[
	---------------------------------------------------------------------
	]])

	print("Done.")
	print("Was running with args:")
	show_args(execargs)

	if cfg_role == "chainid" then
		print("chainid role: before exit, print out the saved ChainID from file=["..global_filename_for_chainid.."] at pwd=[" .. lfs.currentdir() .."]" )
		show_file_all( global_filename_for_chainid )
	end

	pause=false
	for _, v in ipairs(arg) do
		if v == "-pause" then pause=true; end
	end
	if pause then sandboxdir:set_pause(true); end

	sandboxdir:finish()
end

