function get_portindex(arg)
	for i, v in ipairs(arg) do
	local valmin=0
	local valmax=460
		local n = string.match(v, "^%-portindex=(%d+)$")
		if n then
			local port = tonumber(n)
			if port >= valmin and port <= valmax then
				return port
			else
				error("Invalid port index: " .. port .. ". Must be in range " .. valmin .. ".." .. valmax)
			end
		end
	end
	return nil
end

function get_initts(arg)
	for i, v in ipairs(arg) do
		local n = string.match(v, "^%-initts=(%w+)$")
		if n then
			local value = tonumber(n)
			if n == "org" then
				return "org"
			elseif value then
				return value
			else
				error("Invalid initts. Must be unix time or 'org'")
			end
		end -- option is given
	end -- test all option
	return 'org' -- default
end

function get_netip(arg)
	for i, v in ipairs(arg) do
		local n = string.match(v, "^%-netip=(%S+)$")
		if n then
			return n
		end
	end
	return "0.0.0.0"
end

